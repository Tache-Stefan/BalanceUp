# PostgreSQL configuration
POSTGRES_USER=balanceup
POSTGRES_PASSWORD=balanceup
POSTGRES_DB=BalanceUp
POSTGRES_PORT=5433

# Connection string for local host tooling (Alembic / pytest)
DATABASE_URL=postgresql+psycopg://balanceup:balanceup@localhost:5433/BalanceUp

# Backend (FastAPI)
BACKEND_PORT=8000
DEBUG=true
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Frontend (Vite / React)
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
